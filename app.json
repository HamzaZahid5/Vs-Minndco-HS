{
  "name": "MindCotine",
  "displayName": "MindCotine",
  "expo": {
    "name": "MindCotine",
    "slug": "MindCotine",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.habitfly.mindcotine"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.health.habitfly.mindcotine",
      "requireFullScreen": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "publicPath": "./assets",
        "babel": {
          "include": ["rn-sliding-up-panel"]
        }
      }
    }
  }
}
