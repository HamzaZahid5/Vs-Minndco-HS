{
  "name": "MindCotine",
  "displayName": "MindCotine",
  "expo": {
    "name": "MindCotine",
    "slug": "MindCotine",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.habitfly.mindcotine",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "app.relief.the-mind.company",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.health.habitfly.mindcotine",
      "requireFullScreen": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "build": {
        "publicPath": "./assets"
      }
    }
  }
}
