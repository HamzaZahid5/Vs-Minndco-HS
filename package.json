{
  "name": "MindCoRelief",
  "version": "0.2.6",
  "main": "index.js",
  "scripts": {
    "android": "npm run set-dev && npx react-native run-android",
    "android-test": "npm run set-test && npx react-native run-android",
    "android-prod": "npm run set-prod && npx react-native run-android",
    "preandroid-build": "npm run set-prod",
    "android-build": "cd ./android && ./gradlew bundleRelease",
    "ios": "npm run set-dev && npx react-native run-ios",
    "ios-test": "npm run set-test && npx react-native run-ios",
    "ios-prod": "npm run set-prod && npx react-native run-ios",
    "preios-buid": "npm run set-prod",
    "ios-build": "npx react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "preweb": "npm run set-dev",
    "web": "expo start --web",
    "web-test": "npm run set-test && expo start --web",
    "web-prod": "npm run set-prod && expo start --web",
    "start": "npx react-native start",
    "test": "jest --runInBand",
    "headed-test": "export HEADLESS=false && npm run test",
    "clean-android": "rm -rf android/build && rm -rf android/.gradle && rm -rf ./android/app/build",
    "clean-service": "npx react-native-clean-project",
    "format": "prettier --write 'src/**/*.{js,ts,tsx}",
    "google-services-prod": "cp ./android/app/prod_google-services.json ./android/app/google-services.json && cp ./ios/prod_GoogleService-Info.plist ./ios/GoogleService-Info.plist && cp ./web/prod_google-services.json ./web/google-services.json",
    "google-services-dev": "cp ./android/app/dev_google-services.json ./android/app/google-services.json && cp ./ios/dev_GoogleService-Info.plist ./ios/GoogleService-Info.plist && cp ./web/dev_google-services.json ./web/google-services.json",
    "set-test": "echo \"export default 'test';\"> ./env/active.env.js && npm run google-services-dev && node ./env/ip_resolver.js && npm run clean-android",
    "set-dev": "echo \"export default 'dev';\"> ./env/active.env.js && npm run google-services-dev && npm run clean-android",
    "set-prod": "echo \"export default 'prod';\"> ./env/active.env.js && npm run google-services-prod && npm run clean-android",
    "postinstall": "npx patch-package"
  },
  "dependencies": {
    "@react-native-community/blur": "^3.6.0",
    "@react-native-community/cli": "^5.0.1",
    "@react-native-community/masked-view": "0.1.10",
    "@react-native-community/slider": "4.0.0-rc.3",
    "@react-native-firebase/analytics": "^12.7.4",
    "@react-native-firebase/app": "^12.7.4",
    "@react-native-firebase/auth": "^12.7.4",
    "@react-native-firebase/crashlytics": "^12.7.4",
    "@react-native-firebase/dynamic-links": "^12.7.4",
    "@react-native-firebase/firestore": "^12.7.4",
    "@react-native-firebase/functions": "^12.7.4",
    "@react-native-firebase/messaging": "^12.7.4",
    "@react-native-firebase/storage": "^12.7.4",
    "@react-navigation/drawer": "^5.12.4",
    "@react-navigation/native": "^5.9.3",
    "@react-navigation/stack": "^5.14.3",
    "@reduxjs/toolkit": "^1.5.0",
    "add": "^2.0.6",
    "color": "^3.1.3",
    "expo": "~40.0.0",
    "expo-av": "~8.7.0",
    "expo-blur": "~8.2.2",
    "expo-font": "~8.4.0",
    "expo-gl": "~9.2.0",
    "expo-keep-awake": "~8.4.0",
    "expo-linear-gradient": "~8.4.0",
    "expo-localization": "~9.1.0",
    "expo-screen-orientation": "~2.1.0",
    "expo-splash-screen": "~0.8.0",
    "expo-status-bar": "~1.0.3",
    "expo-three": "^5.6.2",
    "expo-updates": "~0.4.0",
    "formik": "^2.2.6",
    "i18n-js": "^3.8.0",
    "lodash.memoize": "^4.1.2",
    "lodash.template": "^4.5.0",
    "moment": "^2.29.1",
    "prop-types": "^15.7.2",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-native": "~0.63.4",
    "react-native-chart-kit": "^6.11.0",
    "react-native-circular-progress": "^1.3.7",
    "react-native-gesture-handler": "~1.8.0",
    "react-native-inappbrowser-reborn": "^3.6.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.3",
    "react-native-orientation-locker": "^1.3.1",
    "react-native-paper": "^4.7.2",
    "react-native-reanimated": "~1.13.0",
    "react-native-safe-area-context": "^3.1.9",
    "react-native-screens": "~2.15.0",
    "react-native-snap-carousel": "^3.9.1",
    "react-native-svg": "12.1.0",
    "react-native-unimodules": "~0.12.0",
    "react-native-vector-icons": "^8.1.0",
    "react-native-web": "~0.13.12",
    "react-native-webview": "11.0.0",
    "react-native-youtube-iframe": "^2.1.0",
    "react-redux": "^7.2.2",
    "react-three-fiber": "^5.3.19",
    "smartlook-react-native-wrapper": "^1.2.1",
    "three": "^0.126.1",
    "yarn": "^1.22.11",
    "yup": "^0.32.9"
  },
  "devDependencies": {
    "@babel/core": "~7.9.0",
    "@react-native-community/eslint-config": "^2.0.0",
    "@types/color": "^3.0.1",
    "@types/i18n-js": "^3.8.2",
    "@types/lodash": "^4.14.171",
    "@types/react": "~16.9.35",
    "@types/react-dom": "~16.9.8",
    "@types/react-native": "~0.63.2",
    "@types/react-native-orientation": "^5.0.1",
    "@types/react-native-vector-icons": "^6.4.6",
    "@types/react-redux": "^7.1.16",
    "babel-jest": "~25.2.6",
    "babel-preset-expo": "~8.3.0",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.22.0",
    "jest": "~25.2.6",
    "jest-expo": "~40.0.0",
    "jest-puppeteer": "^5.0.4",
    "prettier": "^2.3.0",
    "puppeteer": "^10.2.0",
    "react-devtools": "^4.11.0",
    "react-test-renderer": "~16.13.1",
    "redux-devtools-extension": "^2.13.9",
    "typescript": "~4.0.0"
  },
  "jest": {
    "preset": "react-native"
  },
  "private": true
}
